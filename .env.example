PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/echovibe

# REQUIRED. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins. Do NOT use * in production.
CORS_ORIGIN=http://localhost:5173

# Optional: enforces Google ID token audience
GOOGLE_CLIENT_ID=

# Firebase Auth. Public project id -- ID-token verification needs no secret key.
FIREBASE_PROJECT_ID=

# Optional. Unset = in-process cache (fine for a single instance).
# Upstash/Redis Cloud: rediss://default:PASSWORD@host:port
REDIS_URL=
